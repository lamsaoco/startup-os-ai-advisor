NOTION_API_KEY=your_notion_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Notion
NOTION_ROOT_PAGE_ID=your_root_page_id_here   # Found at the end of the Notion page URL (32 hex chars)

# PostgreSQL
# IMPORTANT: Use "postgres" when running via Docker Airflow (Docker Compose service name)
#            Use "localhost" when running scripts directly on the host machine
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=startup_os
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Airflow — must match the host user UID to avoid volume write permission errors
# Run `id -u` on the host to get the correct value
AIRFLOW_UID=1000

# Airflow email alerts on task failure (optional — leave dummy values to disable)
# Gmail requires an App Password, NOT your regular Gmail password
# Generate one at: https://myaccount.google.com/apppasswords
ALERT_EMAIL=admin@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dummy
SMTP_PASSWORD=dummy
